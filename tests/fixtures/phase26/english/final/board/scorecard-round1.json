  "deductions": [
    {
      "number": 54,
      "category": "fatal",
      "rule": "all.solution",
      "points": 0,
      "evidence": "上下文暗示把非正式复盘桌排除在成绩表之外，但原句为‘I left it [54] ___ on the results chart.’，A代入成‘left it off on the results chart’，不同于正常的‘left it off the results chart’；C代入‘left it open on the results chart’语法通顺并可能理解为留空。空后的on削弱唯一性。改为‘I left that table [54] ___ the results chart.’可保留A作正解。",
      "reader": "solver"
    },
    {
      "number": 17,
      "category": "weak",
      "rule": "english.distractor",
      "points": 3,
      "evidence": "B说金属很轻，脚本未谈重量；C说盒子上有俱乐部名字，也没有相应描述。两个干扰项均不考对原对白理由的区分，可用‘相片里有人交还铜牌’等真实但发生较晚的细节替换一项。",
      "reader": "solver"
    },
    {
      "number": 1,
      "category": "fatal",
      "rule": "all.solution",
      "points": 0,
      "evidence": "第1题前第一节共享指令明写“每段对话读两遍”，影响1–5题（7.5听力原始分）。2025全国一卷原卷第一节要求每段仅读一遍，第二节才读两遍。正式施测如依印刷指令操作，重听机会和时间改变；应将第一节卷头及实际播报改为一遍，第二节保持两遍。原卷卷首转载：https://img.gaokaozhitongche.com/resource/pdf/paper/202506/20250611102815_OVucWX.pdf",
      "reader": "pedagogy"
    },
    {
      "number": 54,
      "category": "fatal",
      "rule": "all.solution",
      "points": 0,
      "evidence": "题面“I left it ___ on the results chart.”欲表达不列入表格时需“left it off the results chart”，填 A off 实为off on；C open 可表示将表上位置空着，D marked亦能表示保留标识。it承接场地上的space，文中没有明确表上为之留格或作标。无法同时满足叙事与自然搭配，不能稳定唯一给分。",
      "reader": "pedagogy"
    },
    {
      "number": 50,
      "category": "graphic",
      "rule": "all.graphic",
      "points": 2,
      "evidence": "完形41—55的全部编号空在第10页，而一词一行的选项排到第12页；50—55每题都需跨两页回读同一段材料。四项改为同排／两列，可将题组与原文就近排印。",
      "reader": "visual"
    },
    {
      "number": 66,
      "category": "graphic",
      "rule": "all.graphic",
      "points": 2,
      "evidence": "第13页要求按下列格式写约80词，Dear Jo, 与 Yours, 之间仅普通行距；第14页要求约150词且保留段首，两段首句也相邻。学生PDF未说明另纸作答，按印好格式无法落笔完成两篇。",
      "reader": "visual"
    }
