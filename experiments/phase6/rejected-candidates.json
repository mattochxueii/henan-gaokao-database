          "version": 1,
          "spec_sha256": "5e45f8ac73eaa4a444e2a2b8bfcbba6e4593324fa230011787fe9e6352f28cf4",
          "stem": "设 {{f1}}，函数 {{f2}} 的定义域为 {{f3}}。",
