  "cards": [
    {
      "id": "review24-time-and-method",
      "source": "review-2024",
      "location": "一、依托高考评价体系，创新试卷结构设计",
      "observation": "减少题量及繁难运算，为分析与思考留时。优化不同题型的分值分配。"
    },
    {
      "id": "review24-definition",
      "source": "review-2024",
      "location": "创新情境、呈现和设问，全国新课标Ⅰ卷第19题",
      "observation": "用等差数列提供知识基础，引入可分的新定义，让学生读取规则、分析并自选策略求证。"
    },
    {
      "id": "review25-rotation",
      "source": "review-2025",
      "location": "优化试卷结构、考查灵活思维",
      "observation": "两份全国卷的内容顺序可以不同。各模块难度随整卷要求和试题位置动态调整。"
    },
    {
      "id": "review25-open",
      "source": "review-2025",
      "location": "创新试题设计、强化思维考查及探索性",
      "observation": "增加解法开放性，引导通过不同路径探究、论证，弱化细分题型和机械套路的复习。"
    },
    {
      "id": "review26-conic",
      "source": "review-2026",
      "location": "第二部分、第三部分，全国Ⅰ卷第18题",
      "observation": "解析几何强调课内基本方法。可结合平面几何、三角函数减少演算，鼓励主动选择表示或转化。"
    },
    {
      "id": "review26-inquiry",
      "source": "review-2026",
      "location": "第三部分、第四部分，全国Ⅰ卷第7、8、19题",
      "observation": "从真实或新定义情境提取结构。强调对称性、向量意义、多路径探究和论证。"
    },
    {
      "id": "observed-module-rotation",
      "source": "position-comparison",
      "location": "逐位对照第1–3、9–11、15–17题",
      "observation": "正式卷与演练中首题集合、复数、统计互换，立几、三角、计数概率主观题出现于不同位置。"
    },
    {
      "id": "observed-turning-points",
      "source": "position-comparison",
      "location": "逐位对照第7–11、14、18–19题",
      "observation": "使用新定义、图形、数据或规则的题位有变动。换元、边界分类、反例检验、构造与全域论证可在不同外壳中使用。"
    }
  ],
  "scope": "原试题与命题机构发布的评析分别记录。只用于按题位提取数学动作，正式卷、演练卷与官方方向证据各有观察边界。资料归档时间与试题公开时间是不同的事件。"
